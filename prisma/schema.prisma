// TNBESSDB (shared with ESS_Backend).
// These models mirror tables that ESS owns. NEVER run `prisma db push` or
// `prisma migrate` against this database: Prisma would try to drop every
// table that is not declared here. Only `prisma generate` is safe.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["rbac", "General", "Employee"]
}

model User {
  userId                BigInt    @id @default(autoincrement()) @map("UserId")
  userPrincipalName     String?   @unique @map("UserPrincipalName") @db.NVarChar(256)
  authProviderId        BigInt    @map("AuthProviderId")
  externalSubject       String?   @map("ExternalSubject") @db.NVarChar(255)
  userName              String    @unique @map("UserName") @db.NVarChar(100)
  email                 String    @unique @map("Email") @db.NVarChar(255)
  displayName           String    @map("DisplayName") @db.NVarChar(500)
  isActive              Boolean   @default(true) @map("IsActive")
  isLocked              Boolean   @default(false) @map("IsLocked")
  lastLoginAt           DateTime? @map("LastLoginAt") @db.DateTime2
  passwordHash          String?   @map("PasswordHash") @db.NVarChar(500)
  passwordSalt          String?   @map("PasswordSalt") @db.NVarChar(255)
  passwordLastChangedAt DateTime? @map("PasswordLastChangedAt") @db.DateTime2
  failedLoginCount      Int       @default(0) @map("FailedLoginCount")
  lockedAt              DateTime? @map("LockedAt") @db.DateTime2
  mustChangePassword    Boolean   @default(false) @map("MustChangePassword")
  createdAt             DateTime  @map("CreatedAt") @db.DateTime2
  createdBy             String?   @map("CreatedBy") @db.NVarChar(100)
  updatedAt             DateTime  @map("UpdatedAt") @db.DateTime2
  updatedBy             String?   @map("UpdatedBy") @db.NVarChar(100)

  authProvider AuthProvider @relation(fields: [authProviderId], references: [authProviderId], onDelete: NoAction, onUpdate: NoAction)
  userRoles    UserRole[]

  @@map("Users")
  @@schema("rbac")
}

model AuthProvider {
  authProviderId   BigInt   @id @default(autoincrement()) @map("AuthProviderId")
  authProviderCode String   @unique @map("AuthProviderCode") @db.NVarChar(50)
  isActive         Boolean  @default(true) @map("IsActive")
  createdAt        DateTime @map("CreatedAt") @db.DateTime2
  createdBy        String?  @map("CreatedBy") @db.NVarChar(100)
  updatedAt        DateTime @map("UpdatedAt") @db.DateTime2
  updatedBy        String?  @map("UpdatedBy") @db.NVarChar(100)

  users User[]

  @@map("AuthProviders")
  @@schema("rbac")
}

model Role {
  roleId    BigInt   @id @default(autoincrement()) @map("RoleId")
  roleCode  String   @unique @map("RoleCode") @db.NVarChar(50)
  roleName  String   @map("RoleName") @db.NVarChar(100)
  isActive  Boolean  @default(true) @map("IsActive")
  createdAt DateTime @map("CreatedAt") @db.DateTime2
  createdBy String?  @map("CreatedBy") @db.NVarChar(100)
  updatedAt DateTime @map("UpdatedAt") @db.DateTime2
  updatedBy String?  @map("UpdatedBy") @db.NVarChar(100)

  userRoles UserRole[]

  @@map("Roles")
  @@schema("rbac")
}

model UserRole {
  userRoleId    BigInt   @id @default(autoincrement()) @map("UserRoleId")
  userId        BigInt   @map("UserId")
  roleId        BigInt   @map("RoleId")
  companyId     Int?     @map("CompanyId")
  divisionId    Int?     @map("DivisionId")
  unitSectionId Int?     @map("UnitSectionId")
  isActive      Boolean  @default(true) @map("IsActive")
  createdAt     DateTime @map("CreatedAt") @db.DateTime2
  createdBy     String?  @map("CreatedBy") @db.NVarChar(100)
  updatedAt     DateTime @map("UpdatedAt") @db.DateTime2
  updatedBy     String?  @map("UpdatedBy") @db.NVarChar(100)

  user User @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  role Role @relation(fields: [roleId], references: [roleId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([roleId, userId])
  @@map("UserRoles")
  @@schema("rbac")
}

// Read-only subset of General.Employee (only the columns atquest reads).
model Employee {
  employeeId     String  @id @map("EmployeeID") @db.UniqueIdentifier
  loginName      String? @map("LoginName") @db.VarChar(100)
  employeeStatus String? @map("EmployeeStatus") @db.VarChar(50)
  employeeCode   String?   @map("EmployeeCode") @db.VarChar(50)
  employeeName   String?   @map("EmployeeName") @db.VarChar(100)
  areaCode       String?   @map("AreaCode") @db.VarChar(50)
  areaName       String?   @map("AreaName") @db.VarChar(100)
  subAreaCode    String?   @map("SubAreaCode") @db.VarChar(50)
  subAreaName    String?   @map("SubAreaName") @db.VarChar(100)
  positionCode   String?   @map("PositionCode") @db.VarChar(50)
  positionName   String?   @map("PositionName") @db.VarChar(100)
  jobKeyName     String?   @map("JobKeyName") @db.VarChar(100)
  joinDate       DateTime? @map("JoinDate") @db.SmallDateTime
  managerName    String?   @map("ManagerName") @db.VarChar(100)

  @@map("Employee")
  @@schema("General")
}

// General.Role (approver roles; named GeneralRole to avoid clashing with rbac.Roles).
model GeneralRole {
  id            String    @id @map("ID") @db.UniqueIdentifier
  applicationId String?   @map("ApplicationID") @db.UniqueIdentifier
  roleCode      String?   @map("RoleCode") @db.NVarChar(50)
  roleDesc      String?   @map("RoleDesc") @db.NVarChar(Max)
  needHierarchy Boolean?  @map("NeedHierarchy")
  createdBy     String?   @map("CreatedBy") @db.UniqueIdentifier
  createdDate   DateTime? @map("CreatedDate") @db.DateTime
  modifiedBy    String?   @map("ModifiedBy") @db.UniqueIdentifier
  modifiedDate  DateTime? @map("ModifiedDate") @db.DateTime

  @@map("Role")
  @@schema("General")
}

// Read-only subsets of the org-structure dropdown tables.
model Company {
  id       Int     @id @map("Id")
  code     String  @map("Code") @db.VarChar(50)
  name     String  @map("Name") @db.VarChar(150)
  isActive Boolean @map("IsActive")

  @@map("Company")
  @@schema("Employee")
}

model Division {
  id        Int     @id @map("Id")
  companyId Int     @map("CompanyId")
  code      String  @map("Code") @db.VarChar(50)
  name      String  @map("Name") @db.VarChar(150)
  isActive  Boolean @map("IsActive")

  @@map("Division")
  @@schema("Employee")
}

model UnitSection {
  id         Int     @id @map("Id")
  divisionId Int     @map("DivisionId")
  code       String  @map("Code") @db.VarChar(50)
  name       String  @map("Name") @db.VarChar(150)
  isActive   Boolean @map("IsActive")

  @@map("UnitSection")
  @@schema("Employee")
}

model MaintenanceCategory {
  id       Int     @id @map("Id")
  name     String  @map("Name") @db.VarChar(150)
  isActive Boolean @map("IsActive")

  @@map("MaintenanceCategory")
  @@schema("General")
}

model MaintenanceType {
  id       Int     @id @map("Id")
  name     String  @map("Name") @db.VarChar(150)
  isActive Boolean @map("IsActive")

  @@map("MaintenanceType")
  @@schema("General")
}

model MaintenanceStatus {
  id       Int     @id @map("Id")
  name     String  @map("Name") @db.VarChar(150)
  isActive Boolean @map("IsActive")

  @@map("MaintenanceStatus")
  @@schema("General")
}
