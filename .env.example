# TNBESSDB (shared with ESS_Backend). Never run `prisma db push` / `migrate` against it.
DATABASE_URL="sqlserver://localhost:14330;database=TNBESSDB;user=sa;password=CHANGE_ME;encrypt=true;trustServerCertificate=true"
PORT=4000

JWT_SECRET="CHANGE_ME"
JWT_EXPIRES_IN="7d"

# Login lockout (ESS Jwt:MaxFailedLogins / Jwt:LockMinutes)
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15

# TODO placeholder identity for the /v1 endpoints migrated from ESS_Backend
ESS_ACTING_EMPLOYEE_ID="58308791-89fb-45d1-8a9e-72e430f8e677"
ESS_ACTING_IS_ESS_ADMIN=true

# ESS Pagination section
ESS_PAGINATION_DEFAULT_PAGE=1
ESS_PAGINATION_DEFAULT_PAGE_SIZE=10
